{
  "name": "peerora-client",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:exe": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.theosdev.peerora",
    "productName": "Peerora",
    "directories": {
      "output": "release-exe"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    }
  }
}